{
  "manifest_version": 3,
  "name": "SimpleHome",
  "version": "1.0.0",
  "description": "Your custom home page on every new tab, with EasyList-based ad and tracker blocking.",
  "minimum_chrome_version": "116",

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SimpleHome",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
